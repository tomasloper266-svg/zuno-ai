# ZUNO AI — environment template (placeholders only; safe to commit).
#
# Copy to `.env.local` and fill in. Never commit a filled-in file:
# `.env*` is gitignored (except this example).

# Optional: base URL of a real chat backend.
# When set, ZUNO calls  POST {VITE_API_URL}/chat  with  { messages: [{ role, content }, ...] }
# and expects a JSON response of the shape  { reply: string }.
# Leave it EMPTY to run in clearly-labeled demo mode (scripted replies, no live model).
VITE_API_URL=

# NOTE: anything bundled into a frontend is public. Never place private API keys
# or provider secrets in frontend code or in VITE_* variables.
